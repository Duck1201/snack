{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snack-ai.dev/schemas/commands/stats.schema.json",
  "title": "snack stats payload",
  "description": "The `data` of a `snack stats --json` document. One report when the installation has a single capacity source, otherwise one per source under `sources`. Describes observed usage; it never states a share of a provider's real capacity. Frozen at 0.9: a field here does not disappear or change meaning without a major release, and a consumer must tolerate fields added by a later minor.",
  "oneOf": [
    {
      "$ref": "#/$defs/report"
    },
    {
      "type": "object",
      "required": ["sources"],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/report"
          }
        }
      }
    }
  ],
  "$defs": {
    "report": {
      "type": "object",
      "required": ["source", "horizons", "pressure", "calibration"],
      "properties": {
        "source": {
          "type": "object",
          "required": ["alias", "provider", "profile", "plan", "plan_profile"],
          "properties": {
            "alias": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "profile": {
              "type": "string"
            },
            "plan": {
              "type": "string"
            },
            "plan_profile": {
              "$ref": "https://snack-ai.dev/schemas/commands/status.schema.json#/$defs/planProfile"
            }
          }
        },
        "horizons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/horizon"
          }
        },
        "pressure": {
          "$ref": "https://snack-ai.dev/schemas/commands/status.schema.json#/$defs/pressure"
        },
        "calibration": {
          "description": "How past forecasts actually scored. Absent numbers stay null rather than being reported as zero.",
          "type": "object",
          "required": ["policy_version", "snapshots", "undelivered_attempts", "live", "backtest"],
          "properties": {
            "policy_version": {
              "type": "string"
            },
            "snapshots": {
              "type": "integer"
            },
            "undelivered_attempts": {
              "type": "integer"
            },
            "live": {
              "type": ["object", "null"]
            },
            "backtest": {
              "type": ["object", "null"]
            },
            "by_method": {
              "description": "Added in 1.5.0, optional. Calibration per method, present whenever a shadow method runs: on every source from 1.6.0 (in 1.5 only when a Codex CLI installation feeds the source; `reported_capacity` on `status` is the signal for that, never this member's presence). Ordered: the answering method first, then `reported-capacity@1` where a Codex CLI installation feeds the source -- those two entries are the ones 1.5 emitted -- then the weighting variants by ascending recency half-life, `bayesian-pressure-band-hl50@1` and `bayesian-pressure-band-hl100@1` (1.6.0), each scored live from the rows recorded beside delivered attempts since 1.6.0 and, in `backtest`, only at prompts where its ladder reads an outcome of the user's. Each entry carries its own streams and sample sizes; methods and versions are never pooled. `role` is `answer` for the method whose forecast the user was shown and `shadow` for one computed and recorded beside it and never shown as the answer (ADR-0007, amended 1.5.0). `includes` lists the method identifiers folded into the entry: `initial-generic@1` is the baseline model's last rung, so it belongs to `bayesian-pressure-band@1`. `live` scores the forecasts recorded at delivered attempts; `backtest` replays the history as of each prompt, and for a shadow method scores only the prompts where it would have been computed. A shadow entry's `paired` compares its Brier score with the answering baseline's over exactly the same outcomes. The top-level `live` and `backtest` keep their meaning and their numbers.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/methodCalibration"
              }
            }
          }
        },
        "by_client": {
          "description": "Present only for `--by-client`: the same window split per client feeding the source.",
          "type": ["array", "null"]
        }
      }
    },
    "methodCalibration": {
      "type": "object",
      "required": ["id", "version", "role", "includes", "live", "backtest"],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "role": {
          "enum": ["answer", "shadow"]
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "live": {
          "type": "object"
        },
        "backtest": {
          "type": "object",
          "required": ["forecasts"],
          "properties": {
            "forecasts": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "paired": {
          "description": "Present on a shadow entry only: the shadow method and the answering baseline scored over the same outcomes, live and replayed. Brier scores are null, never zero, while `sample_size` is 0.",
          "type": "object",
          "required": ["live", "backtest"],
          "properties": {
            "live": {
              "$ref": "#/$defs/pairedComparison"
            },
            "backtest": {
              "$ref": "#/$defs/pairedComparison"
            }
          }
        }
      }
    },
    "pairedComparison": {
      "type": "object",
      "required": ["sample_size", "restrictions", "brier", "baseline_brier"],
      "properties": {
        "sample_size": {
          "type": "integer",
          "minimum": 0
        },
        "restrictions": {
          "type": "integer",
          "minimum": 0
        },
        "brier": {
          "type": ["number", "null"]
        },
        "baseline_brier": {
          "type": ["number", "null"]
        }
      }
    },
    "horizon": {
      "type": "object",
      "required": [
        "horizon",
        "window",
        "dimensions",
        "cost",
        "by_model",
        "duration",
        "restrictions",
        "freshness",
        "effective_sample_size",
        "policy_version",
        "prompts"
      ],
      "properties": {
        "horizon": {
          "description": "The ISO-8601 duration this window covers, half-open.",
          "type": "string"
        },
        "window": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          }
        },
        "dimensions": {
          "type": "object",
          "required": [
            "input_tokens",
            "output_tokens",
            "reasoning_tokens",
            "cache_read_tokens",
            "cache_write_tokens"
          ],
          "properties": {
            "input_tokens": {
              "type": "object",
              "required": ["sample_size", "missing", "complete"],
              "properties": {
                "status": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "sample_size": {
                  "type": "integer"
                },
                "missing": {
                  "type": "integer"
                },
                "complete": {
                  "type": "boolean"
                }
              }
            },
            "output_tokens": {
              "type": "object",
              "required": ["sample_size", "missing", "complete"],
              "properties": {
                "status": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "sample_size": {
                  "type": "integer"
                },
                "missing": {
                  "type": "integer"
                },
                "complete": {
                  "type": "boolean"
                }
              }
            },
            "reasoning_tokens": {
              "type": "object",
              "required": ["sample_size", "missing", "complete"],
              "properties": {
                "status": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "sample_size": {
                  "type": "integer"
                },
                "missing": {
                  "type": "integer"
                },
                "complete": {
                  "type": "boolean"
                }
              }
            },
            "cache_read_tokens": {
              "type": "object",
              "required": ["sample_size", "missing", "complete"],
              "properties": {
                "status": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "sample_size": {
                  "type": "integer"
                },
                "missing": {
                  "type": "integer"
                },
                "complete": {
                  "type": "boolean"
                }
              }
            },
            "cache_write_tokens": {
              "type": "object",
              "required": ["sample_size", "missing", "complete"],
              "properties": {
                "status": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "sample_size": {
                  "type": "integer"
                },
                "missing": {
                  "type": "integer"
                },
                "complete": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "cost": {
          "type": "object",
          "required": ["sample_size", "missing", "complete"],
          "properties": {
            "by_currency": {
              "type": ["object", "null"]
            },
            "sample_size": {
              "type": "integer"
            },
            "missing": {
              "type": "integer"
            },
            "complete": {
              "type": "boolean"
            }
          }
        },
        "by_model": {
          "type": "array"
        },
        "duration": {
          "type": "object",
          "required": ["sample_size", "missing", "complete"],
          "properties": {
            "status": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "sample_size": {
              "type": "integer"
            },
            "missing": {
              "type": "integer"
            },
            "complete": {
              "type": "boolean"
            }
          }
        },
        "restrictions": {
          "type": "object",
          "required": ["sample_size"],
          "properties": {
            "by_class": {
              "type": ["object", "null"]
            },
            "unit": {
              "type": "string"
            },
            "sample_size": {
              "type": "integer"
            }
          }
        },
        "freshness": {
          "$ref": "https://snack-ai.dev/schemas/commands/status.schema.json#/$defs/freshness"
        },
        "effective_sample_size": {
          "description": "How much the window is really worth after time weighting, which is smaller than the raw count.",
          "type": "object",
          "required": ["value", "unit", "sample_size", "half_life_seconds"],
          "properties": {
            "value": {
              "type": ["number", "null"]
            },
            "unit": {
              "type": "string"
            },
            "sample_size": {
              "type": "integer"
            },
            "half_life_seconds": {
              "type": ["number", "null"]
            }
          }
        },
        "policy_version": {
          "type": "string"
        },
        "prompts": {
          "type": "object",
          "required": ["count", "eligible", "successes", "restrictions", "excluded"],
          "properties": {
            "count": {
              "type": "integer"
            },
            "eligible": {
              "type": "integer"
            },
            "successes": {
              "type": "integer"
            },
            "restrictions": {
              "type": "integer"
            },
            "excluded": {
              "type": "integer"
            },
            "unit": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
