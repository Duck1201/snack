{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snack-ai.dev/schemas/config/v1",
  "title": "SNACK configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "installation_id",
          "adapter",
          "provider",
          "profile",
          "plan",
          "fingerprint"
        ],
        "oneOf": [
          {
            "description": "OpenCode reads one SQLite database.",
            "properties": {
              "adapter": { "const": "opencode" },
              "fingerprint": { "const": "oc-sqlite-msgpart-v1" },
              "database": true,
              "projects": false
            },
            "required": ["adapter", "database"]
          },
          {
            "description": "Claude Code reads a directory of JSONL session histories.",
            "properties": {
              "adapter": { "const": "claude" },
              "fingerprint": { "const": "cc-jsonl-turntree-v1" },
              "projects": true,
              "database": false
            },
            "required": ["adapter", "projects"]
          }
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62})$"
          },
          "installation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "adapter": {
            "enum": ["opencode", "claude"]
          },
          "database": {
            "type": "string",
            "minLength": 1,
            "description": "OpenCode's own SQLite database."
          },
          "projects": {
            "type": "string",
            "minLength": 1,
            "description": "Claude Code's projects directory of JSONL session histories."
          },
          "provider": {
            "$ref": "#/$defs/localIdentifier"
          },
          "profile": {
            "$ref": "#/$defs/localIdentifier"
          },
          "plan": {
            "$ref": "#/$defs/localIdentifier"
          },
          "plan_profile": {
            "type": "string",
            "minLength": 1,
            "description": "Bundled plan-profile id, or a path to a local user-defined profile."
          },
          "fingerprint": {
            "enum": ["oc-sqlite-msgpart-v1", "cc-jsonl-turntree-v1"]
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "horizons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^P(?!$)(?:\\d+D)?(?:T(?=\\d)(?:\\d+H)?(?:\\d+M)?(?:\\d+S)?)?$"
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "json": {
          "type": "boolean"
        }
      }
    },
    "prospective_analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "localIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    }
  }
}
