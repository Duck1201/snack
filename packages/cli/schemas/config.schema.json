{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snack-ai.dev/schemas/config/v1",
  "title": "SNACK configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "horizons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^P(?!$)(?:\\d+D)?(?:T(?=\\d)(?:\\d+H)?(?:\\d+M)?(?:\\d+S)?)?$"
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "json": {
          "type": "boolean"
        }
      }
    },
    "prospective_analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
